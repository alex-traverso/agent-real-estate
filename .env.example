# Copy this file to .env in each app that needs it (apps/api/.env, apps/admin/.env.local)
# and fill in real values. Never commit the resulting .env files.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Used by: apps/admin (Supabase Auth, RLS-enforced client)
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# --- Anthropic --------------------------------------------------------------
# Key in: https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- OpenAI (embeddings only) -----------------------------------------------
# Key in: https://platform.openai.com/api-keys
# Used by: apps/api/supabase/seed.ts (generates property embeddings) and, later, the embeddings module consumed by the agent's semantic search tool
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=

# --- Meta Cloud API -----------------------------------------------------
# Used by: apps/api webhook module (not implemented yet)
META_VERIFY_TOKEN=
META_API_TOKEN=
META_PHONE_NUMBER_ID=

# --- Resend ---------------------------------------------------------------
# Used by: apps/api notifications module (not implemented yet)
RESEND_API_KEY=

