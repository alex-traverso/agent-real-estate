# Copy this file to .env in each app that needs it (apps/api/.env, apps/admin/.env.local)
# and fill in real values. Never commit the resulting .env files.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Used by: apps/admin (Supabase Auth, RLS-enforced client)
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# --- apps/admin -> apps/api -----------------------------------------------
# Base URL of the NestJS API. Server-only (no NEXT_PUBLIC_ prefix): every
# request happens in Server Components/Server Actions, never in the browser,
# so this never reaches the client bundle and apps/api needs no CORS config.
API_URL=http://localhost:3000

# --- Anthropic --------------------------------------------------------------
# Key in: https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- OpenAI (embeddings only) -----------------------------------------------
# Key in: https://platform.openai.com/api-keys
# Used by: apps/api/supabase/seed.ts (generates property embeddings) and, later, the embeddings module consumed by the agent's semantic search tool
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=

# --- Meta Cloud API -----------------------------------------------------
# META_APP_SECRET + META_VERIFY_TOKEN: used by apps/api webhook (verification + signature validation)
# META_API_TOKEN + META_PHONE_NUMBER_ID: used by the outbound sender (messaging module).
# META_PHONE_NUMBER_ID is also read by the seed to link the demo agency
# (agencies.whatsapp_phone_number_id) so inbound webhooks resolve to a tenant.
# The Graph API version is a pinned code constant (messaging.constants.ts), not an env var.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_API_TOKEN=
META_PHONE_NUMBER_ID=

# --- Resend ---------------------------------------------------------------
# Used by: apps/api notifications module (advisor escalation emails).
RESEND_API_KEY=
# Optional "From" address for advisor emails. Defaults to Resend's shared test
# sender (onboarding@resend.dev); set a verified-domain address in production.
NOTIFICATIONS_FROM_EMAIL=

